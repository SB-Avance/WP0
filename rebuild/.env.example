# Example environment variables for local development
# Copy to .env and fill values. Never commit real secrets.

# Runtime
ENVIRONMENT=local

# Dataverse / Azure AD (used by MSAL client-credentials flow)
# Example: https://your-org.crm.dynamics.com
DATAVERSE_URL=https://your-org.crm.dynamics.com
# Azure AD tenant and app registration
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# WhatsApp Graph API
PHONE_NUMBER_ID=your-phone-number-id
# Long-lived page or app access token for WhatsApp (store in CI secrets)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Webhook verification token (used to verify incoming webhook challenge)
VERIFY_TOKEN=your-webhook-verify-token

# CI / Deployment: map these env vars to repository secrets in GitHub Actions
# Recommended secret names (Repository > Settings > Secrets):
# - DATAVERSE_URL
# - TENANT_ID
# - CLIENT_ID
# - CLIENT_SECRET
# - PHONE_NUMBER_ID
# - WHATSAPP_ACCESS_TOKEN
# - VERIFY_TOKEN
