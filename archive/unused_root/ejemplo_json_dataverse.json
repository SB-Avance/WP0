          "activo": true,
          "tags": ["ventas", "catalogo", "pdf"],
          "sin_asignacion": true
        }
      ]
    },

    {
      "numero": "3",
      "nombre": "Solicitar Atención",
      "descripcion": "Atención directa con un agente",
      "activo": true,

      "submenus": [
        {
          "numero": "3.1",
          "nombre": "Asignación Directa",
          "descripcion": "Asignar a un agente sin preguntas",
